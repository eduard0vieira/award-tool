# Supervisor (scripts/run-server.ts)
DEPLOY_BRANCH=
UPDATE_CHECK_MS=

# Users created by `npm run db:seed` (name:password, comma separated). Only
# missing users are created; an existing password is never reset.
SEED_USERS=

# AwardTool (TAP)
