# Copy to .env and fill in. Never commit .env.

# Server
PORT=
BOT_AUTH_USER=
BOT_AUTH_PASS=
IDLE_MINUTES=
ANSWER_TIMEOUT_MS=
AWARDTOOL_CONCURRENCY=
SEATSPY_CONCURRENCY=
AA_CONCURRENCY=
LATAM_CONCURRENCY=
SMILES_CONCURRENCY=
